{
  "layer": "top",
  "position": "top",
  "height": 32,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 0,

  "modules-left": [
    "network#speed",
    "custom/gpu",
    "custom/ollama",
    "custom/docker"
  ],
  "modules-center": [
    "hyprland/workspaces"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "custom/storage",
    "pulseaudio",
    "network",
    "bluetooth",
    "battery",
    "custom/updates",
    "clock",
    "custom/power"
  ],

  // --- LEFT SIDE DIAGNOSTICS & INFRASTRUCTURE ---
  "network#speed": {
    "interval": 1,
    "format-wifi": " {bandwidthDownBytes}   {bandwidthUpBytes}",
    "format-ethernet": " {bandwidthDownBytes}   {bandwidthUpBytes}",
    "format-disconnected": "󰖪  No Net",
    "tooltip-format": "󰈀 Interface: {ifname}\n󰩟 Local IP: {ipaddr}",
    "on-click": "python3 /home/adi/.config/waybar/scripts/wifi_docket.py"
  },

  "custom/gpu": {
    "interval": 2,
    "format": "󰾲  {:.0f}%   {:.0f}°C",
    "exec": "nvidia-smi --query-gpu=utilization.gpu,temperature.gpu --format=csv,noheader,nounits | awk -F', ' '{print $1 \" \" $2}'",
    "tooltip-format": "NVIDIA GPU Status\nLeft-Click: Detailed View",
    "on-click": "kitty -e nvidia-smi"
  },

  "custom/ollama": {
    "interval": 3,
    "format": "  LLMs: {}",
    "exec": "models=$(ollama list | grep -v 'NAME' | wc -l); active=$(ollama ps | grep -v 'NAME' | awk '{print $1}' | tr '\\n' ' ' | sed 's/ $//'); [ -z \"$active\" ] && active=\"Idle\"; echo \"$models ($active)\"",
    "on-click": "kitty -e sh -c 'ollama list; echo \"\nPress Enter to close...\"; read'",
    "on-click-right": "systemctl --user restart ollama.service",
    "tooltip": true,
    "exec-tooltip": "echo \"Local Storage Library:\"; echo \"-----------------------\"; ollama list | grep -v 'NAME' | awk '{printf \"  %-25s %-10s\\n\", $1, $3}'\n\n[Right-Click to restart Ollama daemon]"
  },

  "custom/docker": {
    "interval": 4,
    "format": "  {}",
    "exec": "running=$(docker ps -q | wc -l); total=$(docker ps -a -q | wc -l); echo \"$running/$total\"",
    "exec-if": "systemctl is-active --quiet docker",
    "on-click": "kitty --class lazydocker -e lazydocker",
    "on-click-right": "kitty -e sh -c 'docker ps -a; echo \"\nPress Enter to close...\"; read'",
    "tooltip-format": "Docker Container Dashboard\n\nActive Containers:\n<tt>{:} </tt>",
    "tooltip": true,
    "exec-tooltip": "docker ps --format 'table {{.Names}}\t{{.Status}}\t{{.Size}}' | sed 's/^/  /'"
  },

  // --- CENTER REGION: Workspaces ---
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "active-only": false,
    "format": "{icon}",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4]
    },
    "format-icons": {
      "default": "",
      "active": ""
    }
  },

  // --- RIGHT SIDE UTILITIES ---
  "cpu": {
    "interval": 2,
    "format": "  {usage}%",
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 2,
    "format": "  {percentage}%",
    "tooltip-format": "RAM Used: {used:0.1f}GiB / {total:0.1f}GiB\nSwap Used: {swapUsed:0.1f}GiB",
    "on-click": "kitty -e btop"
  },

  "custom/storage": {
    "format": "󰋊  {}%",
    "interval": 10,
    "exec": "df / | awk 'NR==2 {print $5}' | sed 's/%//'",
    "tooltip-format": "Available Space on Root partition",
    "on-click": "kitty -e ncdu /"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "default": [" ", " "]
    },
    "scroll-step": 2,
    "on-click": "python3 /home/adi/.config/waybar/scripts/audio_docket.py",
    "on-click-right": "amixer set Master toggle"
  },

  "network": {
    "format-disconnected": "󰖪 Off",
    "format-wifi": "  {essid}",
    "format-ethernet": "󰈀 Wired",
    "tooltip-format-wifi": "󰩟 IP: {ipaddr}\n󨺛 Down: {bandwidthDownBits} | Up: {bandwidthUpBits}\n󰓅 Interface: {ifname}",
    "tooltip-format-ethernet": "󰈀 Interface: {ifname}\n󰩟 IP: {ipaddr}",
    "on-click": "python3 /home/adi/.config/waybar/scripts/wifi_docket.py"
  },

  "bluetooth": {
    "format-on": "󰂯 On",
    "format-off": "󰂲 Off",
    "format-disabled": "󰂲 Off",
    "format-connected-battery": "󰂯 {device_battery_percentage}%",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected-battery": "󰂯 {device_alias}\t{device_battery_percentage}%",
    "on-click": "python3 /home/adi/.config/waybar/scripts/bt_docket.py",
    "on-click-right": "rfkill toggle bluetooth"
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󱐋 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-full": "  {capacity}%",
    "format-icons": [" ", " ", " ", " ", " "],
    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "custom/updates": {
    "format": "󰏔  {}",
    "interval": 1800,
    "exec": "checkupdates | wc -l",
    "exec-if": "which checkupdates",
    "on-click": "kitty -e sh -c 'sudo pacman -Syu; echo \"\nPress Enter to close...\"; read'",
    "signal": 8,
    "tooltip-format": "Pending system updates"
  },

  "clock": {
    "format": "  {:%I:%M %p  |  󰃭 %a, %d %b}",
    "interval": 1,
    "tooltip-format": "󰃭 {:%A, %B %d, %Y}",
    "on-click": "python3 /home/adi/.config/waybar/scripts/clock_docket.py"
  },

  "custom/power": {
    "format": "⏻",
    "on-click": "~/.config/rofi/powermenu.sh",
    "tooltip": false
  }
}